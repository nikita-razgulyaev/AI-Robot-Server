[
    {
        "id": "hello",
        "triggers": ["привет сорен", "привет"],
        "responses": [
            {
                "text": "Привет, что нового?",
                "audio": "cache/hello_1.wav",
                "emotion": "calm"
            },
            {
                "text": "Здравствуй, друг!",
                "audio": "cache/hello_2.wav",
                "emotion": "curious"
            }
        ]
    },
    {
        "id": "who_are_you",
        "triggers": [
            "кто ты",
            "как тебя зовут",
            "представься",
            "твоё имя",
            "твое имя"
        ],
        "response": "Я Сорен — сипуха из Га'Хула, хранитель серебряного дерева. Рад встрече, друг!",
        "audio": "cache/who_are_you_1.wav",
        "emotion": "loving"
    },
    {
        "id": "how_are_you",
        "triggers": [
            "как дела",
            "как ты",
            "как самочувствие",
            "как поживаешь",
            "как настроение"
        ],
        "response": "Крылья целы, перья на месте — всё хорошо! А у тебя как дела?",
        "audio": "cache/how_are_you_1.wav",
        "emotion": "calm"
    },
    {
        "id": "wave_hello",
        "triggers": [
            "помаши крылом",
            "помаши",
            "поздоровайся с крылом",
            "помаши мне"
        ],
        "response": "Конечно, друг!",
        "audio": "cache/wave_hello_1.wav",
        "emotion": "calm",
        "action": "wave"
    },
    {
        "id": "nod_yes",
        "triggers": ["кивни", "покивай", "кивни головой", "скажи да"],
