        "emotion": "calm",
        "action": "shake_head"
    },
    {
        "id": "thanks",
        "triggers": ["спасибо", "благодарю", "спасибо тебе", "спасибо большое"],
        "response": "Всегда пожалуйста, друг!",
        "audio": "cache/thanks_1.wav",
        "emotion": "loving"
    },
    {
        "id": "goodbye",
        "triggers": ["пока", "до свидания", "увидимся", "прощай", "до встречи"],
        "response": "До скорой встречи, друг! Пусть Глаукс хранит тебя.",
        "audio": "cache/goodbye_1.wav",
        "emotion": "loving"
    },
    {
        "id": "behavior_fall",
        "triggers": [],
